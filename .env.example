# Copy this file to .env and fill in your own Nebius API key.
# Never commit .env.

NEBIUS_API_KEY=

# Defaults shown below are the confirmed working values; uncomment/edit
# only if you need something different.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Completion-token budget per turn, applied identically to Memory OFF
# and Memory ON (see sae_demo/compatibility_runner.py,
# resolve_max_tokens). Default is 400 if unset or invalid.
SAE_DEMO_MAX_TOKENS=400

# Memory ON uses whatever artifact this points at. The default below
# is the one Emotional Memory artifact approved for public release and
# packaged with this repository (see docs/DISCLOSURE_BOUNDARY.md,
# "Profile Emotional Memory release status") -- no separate download
# or setup step is needed to try Memory ON.
#
# To use a different, local, gitignored artifact of your own instead,
# point this at a path under .local/memory/ (see README "Local web
# demo" and docs/RUNTIME_DATA_BOUNDARY.md) -- for example:
#   SAE_DEMO_MEMORY_FILE=.local/memory/<name>.json
SAE_DEMO_MEMORY_FILE=demo_memory/despair_profile.json
