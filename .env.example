# Copy this file to .env and fill in your own Nebius API key.
# Never commit .env.

NEBIUS_API_KEY=

# Optional — defaults shown below are the confirmed working values.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional — completion-token budget per turn, applied identically to
# Memory OFF and Memory ON (see sae_demo/compatibility_runner.py,
# resolve_max_tokens). Default is 400 if unset or invalid.
# SAE_DEMO_MAX_TOKENS=400

# Optional — only needed to try Memory ON; points at a local,
# gitignored memory-artifact envelope (see README "Local web demo").
# SAE_DEMO_MEMORY_FILE=.local/memory/<name>.json
