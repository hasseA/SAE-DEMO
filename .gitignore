# Secrets / local configuration — never commit API keys or credentials
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local-private runtime root (M3C.1) — live compatibility run traces,
# provider outputs, generated scenario drafts, a future bounded
# Emotional Memory artifact, and temporary runtime files. See
# docs/RUNTIME_DATA_BOUNDARY.md. Ignored as a whole, one single root.
.local/

# Legacy bounded demo Emotional Memory artifact patterns from Stage 3
# planning — superseded by .local/memory/ (see above) but kept here so
# any file matching this older convention stays ignored too.
demo_memory/
*.demo-memory.json

# Dependencies / build output
node_modules/
dist/
build/
.venv/
__pycache__/
*.pyc

# Test artifacts
.pytest_cache/
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
