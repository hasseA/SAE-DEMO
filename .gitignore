# Secrets / local configuration — never commit API keys or credentials
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local-private runtime root (M3C.1) — live compatibility run traces,
# provider outputs, generated scenario drafts, a future bounded
# Emotional Memory artifact, and temporary runtime files. See
# docs/RUNTIME_DATA_BOUNDARY.md. Ignored as a whole, one single root.
.local/

# demo_memory/ (M2.1 release packaging) — deliberately TRACKED, not
# ignored. It holds exactly one approved, tracked Emotional Memory
# export (demo_memory/despair_profile.json) so a fresh clone can run
# Memory ON with no access to a developer's .local/ directory. See
# docs/RUNTIME_DATA_BOUNDARY.md, "The one tracked exception". Nothing
# else may be added there without a separate, explicit disclosure
# decision -- in particular, never the network-representation artifact.
# The older *.demo-memory.json Stage-3-planning pattern this used to
# reserve was never actually used and is removed; a still-local,
# not-yet-approved artifact belongs under .local/memory/, covered above.

# Dependencies / build output
node_modules/
dist/
build/
.venv/
__pycache__/
*.pyc

# Test artifacts
.pytest_cache/
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
